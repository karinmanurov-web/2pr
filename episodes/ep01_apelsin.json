"subtitles": [
{
"start": 300,
"end": 4200,
"text": "Вы когда-нибудь задумывались, почему апельсин называется именно так?"
},
{
"start": 4700,
"end": 8000,
"text": "В XVII веке голландцы привозили сладкие плоды из Китая и звали их «китайскими яблоками»."
},
{
"start": 8200,
"end": 11300,
"text": "Слово appelsien попало в Россию при Петре Первом и превратилось в привычный «апельсин»."
},
{
"start": 11800,
"end": 17200,
"text": "Фрукт проделал огромный морской путь из Южного Китая через Лиссабон и Амстердам."
},
{
"start": 17800,
"end": 22600,
"text": "При этом в английский и польский слово пришло совсем другим путём — из санскрита."
}
]
